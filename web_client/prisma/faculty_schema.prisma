model Faculty {
  id              String   @id @default(cuid())
  employeeId      String   @unique
  name            String
  email           String   @unique
  phone           String?
  departmentId    String
  designation     String?
  qualification   String?
  experience      Int?
  joiningDate     DateTime?
  employmentType  String   @default("Full Time")
  status          String   @default("Active")
  profilePicture  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  crossDepartments CrossDepartmentTeaching[]
  schedulingProfile SchedulingProfile?
  availability      Availability[]
  leaves            Leave[]
}

model CrossDepartmentTeaching {
  id           String   @id @default(cuid())
  facultyId    String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faculty      Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model SchedulingProfile {
  id                    String   @id @default(cuid())
  facultyId             String   @unique
  maxPeriodsPerDay      Int      @default(4)
  maxPeriodsPerWeek     Int      @default(18)
  maxConsecutiveClasses Int      @default(2)
  preferredFreeDay      String?
  avoidFirstHour        Boolean  @default(false)
  avoidLastHour         Boolean  @default(false)
  canHandleTheory       Boolean  @default(true)
  canHandleLabs         Boolean  @default(true)
  canHandleTutorials    Boolean  @default(true)
  preferredBuildings    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  faculty               Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model Availability {
  id          String   @id @default(cuid())
  facultyId   String
  dayOfWeek   Int
  period      Int
  isAvailable Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model Leave {
  id          String   @id @default(cuid())
  facultyId   String
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("Pending")
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}
